#!/usr/bin/env python3
"""Run a bounded, evidence-retaining Grok Build consultation."""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import uuid


EXIT = {
    "ok": 0,
    "input": 2,
    "missing-cli": 3,
    "isolation-failure": 4,
    "nonzero-exit": 5,
    "timeout": 6,
    "invalid-json": 7,
    "incomplete-stop-reason": 8,
    "max-turns": 9,
}
SUPPORTED_AUTOMATIC_VERSIONS = {"1.0.3"}
AUTOMATIC_MODE_ACCEPTED = False
COMPAT_FLAGS = {
    f"GROK_{vendor}_{surface}_ENABLED": "false"
    for vendor in ("CURSOR", "CLAUDE")
    for surface in ("SKILLS", "RULES", "AGENTS", "MCPS", "HOOKS", "SESSIONS")
}
VERDICTS = {"PROCEED", "PROCEED WITH CHANGES", "REPLAN", "NEEDS HUMAN DECISION"}
REVIEW_KEYS = {
    "verdict",
    "overengineering",
    "missing",
    "risks",
    "minimum_plan_delta",
    "user_decisions",
}
SECRET_PATTERNS = [
    re.compile(
        r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----",
        re.DOTALL,
    ),
    re.compile(
        r"""(?imx)
        (?<![A-Z0-9_])
        [\"']?
        (?:
            (?:[A-Z][A-Z0-9]*_)*
            (?:
                API_KEY|ACCESS_KEY(?:_ID)?|PRIVATE_KEY|SECRET(?:_KEY)?|
                TOKEN|PASSWORD|PASSWD|CREDENTIALS?|DATABASE_URL|DB_URL|CONNECTION_STRING
            )
            |(?:[A-Z][A-Z0-9]*_)+KEY
        )
        (?:_[A-Z0-9]+)*
        [\"']?\s*[:=]\s*
        (?:[\"'][^\"'\r\n]+[\"']|[^\s,;}\]]+)
        """
    ),
    re.compile(r"(?im)^\s*(?:password|passwd|secret|token)\s*[:=]\s*\S+"),
    re.compile(r"\b(?:eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}|(?:xai|sk)-[A-Za-z0-9_-]{16,})\b"),
]

REVIEW_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": sorted(REVIEW_KEYS),
    "properties": {
        "verdict": {"type": "string", "enum": sorted(VERDICTS)},
        "overengineering": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}},
        "minimum_plan_delta": {"type": "array", "items": {"type": "string"}},
        "user_decisions": {"type": "array", "items": {"type": "string"}},
    },
}

AGENT_DEFINITION = """---
name: toolboxmd-plan-reviewer
description: Review only a supplied plan brief without external context.
promptMode: full
tools:
  - todo_write
disallowedTools:
  - Agent
discoverSkills: false
inheritSkills: false
agentsMd: false
mcpInheritance: none
permissionMode: dontAsk
---

Review only the text supplied in the user prompt. Do not inspect other files.
Do not call tools, subagents, Codex, Claude, Grok, or another agentic CLI.
Return only the requested structured review.
"""


class ConsultationError(Exception):
    def __init__(self, category: str, message: str):
        super().__init__(message)
        self.category = category


class StatusArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise ConsultationError("input", f"Argument error: {message}")


def parse_args() -> argparse.Namespace:
    parser = StatusArgumentParser(description=__doc__)
    parser.add_argument("--mode", choices=("explicit", "automatic"), required=True)
    parser.add_argument("--prompt-file", type=Path, required=True)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--grok-home", type=Path)
    parser.add_argument("--grok-bin", default=os.environ.get("GROK_BINARY", "grok"))
    parser.add_argument("--timeout", type=float, default=120.0)
    parser.add_argument("--max-turns", type=int, default=3)
    parser.add_argument("--model")
    return parser.parse_args()


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def write_text(path: Path, value: str) -> None:
    path.write_text(value, encoding="utf-8")


def write_json(path: Path, value: object) -> None:
    write_text(path, json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n")


def emit(payload: dict, code: int) -> int:
    print(json.dumps(payload, sort_keys=True, ensure_ascii=False))
    return code


def read_prompt(path: Path) -> bytes:
    try:
        data = path.read_bytes()
    except OSError as exc:
        raise ConsultationError("input", f"Cannot read prompt file: {exc}") from exc
    if not data or not data.strip():
        raise ConsultationError("input", "Prompt file is empty")
    if len(data) > 100_000:
        raise ConsultationError("input", "Prompt exceeds the 100000-byte limit")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise ConsultationError("input", "Prompt must be UTF-8") from exc
    if any(pattern.search(text) for pattern in SECRET_PATTERNS):
        raise ConsultationError("input", "Prompt matches a protected secret pattern")
    return data


def resolve_binary(name: str) -> str:
    if os.sep in name or (os.altsep and os.altsep in name):
        candidate = Path(name).expanduser().resolve()
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
        raise ConsultationError("missing-cli", f"Grok executable not found: {candidate}")
    found = shutil.which(name)
    if not found:
        raise ConsultationError("missing-cli", f"Grok executable not found on PATH: {name}")
    return found


def resolve_grok_home(args: argparse.Namespace) -> tuple[Path, bool]:
    explicit_value = args.grok_home or (
        Path(os.environ["TOOLBOXMD_GROK_HOME"]) if os.environ.get("TOOLBOXMD_GROK_HOME") else None
    )
    selected = explicit_value or (Path.home() / ".grok")
    selected = selected.expanduser().resolve()
    if args.mode == "automatic":
        if explicit_value is None:
            raise ConsultationError("isolation-failure", "Automatic mode requires an explicit stable GROK_HOME")
        temporary_roots = (Path(tempfile.gettempdir()).resolve(), Path("/private/tmp"))
        if any(selected == root or root in selected.parents for root in temporary_roots):
            raise ConsultationError("isolation-failure", "Automatic GROK_HOME cannot be under a temporary directory")
        if selected == (Path.home() / ".grok").resolve():
            raise ConsultationError("isolation-failure", "Automatic GROK_HOME must be dedicated, not the default profile")
    if not selected.is_dir():
        raise ConsultationError("isolation-failure", f"GROK_HOME does not exist: {selected}")
    return selected, explicit_value is not None


def controlled_env(staged_home: Path, grok_home: Path) -> dict[str, str]:
    allowed = ("PATH", "LANG", "LC_ALL", "TERM", "TMPDIR", "SSL_CERT_FILE", "SSL_CERT_DIR")
    env = {key: os.environ[key] for key in allowed if os.environ.get(key)}
    if os.environ.get("XAI_API_KEY"):
        env["XAI_API_KEY"] = os.environ["XAI_API_KEY"]
    env.update(COMPAT_FLAGS)
    env.update(
        {
            "HOME": str(staged_home),
            "GROK_HOME": str(grok_home),
            "GROK_DISABLE_AUTOUPDATER": "1",
            "NO_COLOR": "1",
        }
    )
    return env


def auth_source(grok_home: Path) -> str | None:
    if os.environ.get("XAI_API_KEY"):
        return "api-key-environment"
    if (grok_home / "auth.json").is_file():
        return "profile-auth-file"
    return None


def run_capture(argv: list[str], cwd: Path, env: dict[str, str], timeout: float = 20.0) -> subprocess.CompletedProcess:
    creationflags = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0) if os.name == "nt" else 0
    process = subprocess.Popen(
        argv,
        cwd=cwd,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=os.name == "posix",
        creationflags=creationflags,
    )
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        stop_process_tree(process)
        process.communicate()
        raise ConsultationError("isolation-failure", f"Preflight timed out: {argv[1]}") from exc
    return subprocess.CompletedProcess(argv, process.returncode, stdout, stderr)


def parse_version(stdout: str) -> str | None:
    match = re.search(r"\bgrok\s+(\d+\.\d+\.\d+)\b", stdout, re.IGNORECASE)
    return match.group(1) if match else None


def inspect_reasons(value: object, strict: bool) -> list[str]:
    if not isinstance(value, dict):
        return ["inspect output is not an object"]
    reasons: list[str] = []
    empty_fields = ("projectInstructions", "mcpServers", "plugins", "hooks", "marketplaces")
    for field in empty_fields:
        if strict and (field not in value or value.get(field) != []):
            reasons.append(f"strict inspect.{field} is not exactly empty")
        elif not strict and value.get(field) not in (None, []):
            reasons.append(f"inspect.{field} is not empty")
    if strict and value.get("skills") != []:
        reasons.append("strict inspect.skills is not exactly empty")
    if strict and ("projectRoot" not in value or value.get("projectRoot") is not None):
        reasons.append("strict inspect.projectRoot is not null")
    elif not strict and value.get("projectRoot") not in (None, ""):
        reasons.append("inspect.projectRoot is set")
    warnings = value.get("configWarnings")
    if strict and ("configWarnings" not in value or warnings not in (None, [])):
        reasons.append("inspect.configWarnings is not empty")
    compat = value.get("externalCompat")
    cells = compat.get("cells", []) if isinstance(compat, dict) else []
    required = {(vendor, surface.lower()) for vendor in ("cursor", "claude") for surface in ("skills", "rules", "agents", "mcps", "hooks", "sessions")}
    observed = {
        (str(cell.get("vendor")), str(cell.get("surface"))): cell
        for cell in cells
        if isinstance(cell, dict)
    }
    for key in sorted(required):
        cell = observed.get(key)
        if not cell or cell.get("enabled") is not False or cell.get("source") != "env":
            reasons.append(f"compat {key[0]}.{key[1]} is not disabled by env")
    if isinstance(compat, dict) and compat.get("remoteSettingsLoaded") is not False:
        reasons.append("remote compatibility settings were loaded")
    permissions = value.get("permissions")
    if strict and (
        not isinstance(permissions, dict) or permissions.get("managedSettingsActive") is not False
    ):
        reasons.append("managed settings state is not explicitly inactive")
    config_sources = value.get("configSources")
    if strict and (
        not isinstance(config_sources, dict) or config_sources.get("layers") != []
    ):
        reasons.append("strict profile configuration layers are not exactly empty")
    return reasons


def preflight(binary: str, args: argparse.Namespace, cwd: Path, env: dict[str, str], leader: Path) -> tuple[str, dict]:
    version_run = run_capture([binary, "--version"], cwd, env)
    if version_run.returncode != 0:
        raise ConsultationError("missing-cli", "grok --version failed")
    version = parse_version(version_run.stdout)
    if not version:
        raise ConsultationError("isolation-failure", "Could not parse Grok version")
    if args.mode == "automatic" and version not in SUPPORTED_AUTOMATIC_VERSIONS:
        raise ConsultationError("isolation-failure", f"Automatic mode is not accepted for Grok {version}")
    inspect_run = run_capture([binary, "inspect", "--json", "--leader-socket", str(leader)], cwd, env)
    if inspect_run.returncode != 0:
        raise ConsultationError("isolation-failure", "grok inspect --json failed")
    try:
        inspected = json.loads(inspect_run.stdout)
    except json.JSONDecodeError as exc:
        raise ConsultationError("isolation-failure", "grok inspect did not return JSON") from exc
    reasons = inspect_reasons(inspected, args.mode == "automatic")
    if reasons:
        raise ConsultationError("isolation-failure", "; ".join(reasons))
    return version, inspected


def inspect_summary(value: dict) -> dict:
    def count(field: str) -> int:
        items = value.get(field)
        return len(items) if isinstance(items, list) else 0

    compat = value.get("externalCompat")
    cells = compat.get("cells") if isinstance(compat, dict) else None
    selected_cells = [
        {
            "vendor": cell.get("vendor"),
            "surface": cell.get("surface"),
            "enabled": cell.get("enabled"),
            "source": cell.get("source"),
        }
        for cell in cells or []
        if isinstance(cell, dict) and cell.get("vendor") in ("cursor", "claude")
    ]
    permissions = value.get("permissions")
    config_sources = value.get("configSources")
    layers = config_sources.get("layers") if isinstance(config_sources, dict) else None
    warnings = value.get("configWarnings")
    return {
        "projectRootSet": value.get("projectRoot") not in (None, ""),
        "projectInstructionCount": len(value.get("projectInstructions") or []),
        "skillCount": count("skills"),
        "agentCount": count("agents"),
        "mcpServerCount": count("mcpServers"),
        "pluginCount": count("plugins"),
        "hookCount": len(value.get("hooks") or []),
        "marketplaceCount": count("marketplaces"),
        "configWarningCount": len(warnings) if isinstance(warnings, list) else (0 if warnings in (None, {}) else 1),
        "configLayerCount": len(layers) if isinstance(layers, list) else None,
        "managedSettingsActive": permissions.get("managedSettingsActive") if isinstance(permissions, dict) else None,
        "remoteSettingsLoaded": compat.get("remoteSettingsLoaded") if isinstance(compat, dict) else None,
        "compatibilityCells": selected_cells,
    }


def stop_process_tree(process: subprocess.Popen, grace: float = 1.0) -> None:
    if os.name == "posix":
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        deadline = time.monotonic() + grace
        while process.poll() is None and time.monotonic() < deadline:
            time.sleep(0.02)
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        if process.poll() is None:
            process.wait(timeout=grace)
    else:
        subprocess.run(
            ["taskkill", "/PID", str(process.pid), "/T", "/F"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def run_grok(argv: list[str], cwd: Path, env: dict[str, str], timeout: float) -> tuple[int | None, str, str, bool, float]:
    creationflags = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0) if os.name == "nt" else 0
    started = time.monotonic()
    process = subprocess.Popen(
        argv,
        cwd=cwd,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=os.name == "posix",
        creationflags=creationflags,
    )
    try:
        stdout, stderr = process.communicate(timeout=timeout)
        return process.returncode, stdout, stderr, False, time.monotonic() - started
    except subprocess.TimeoutExpired:
        stop_process_tree(process)
        stdout, stderr = process.communicate()
        return process.returncode, stdout, stderr, True, time.monotonic() - started


def replace_paths(value: object, replacements: dict[str, str]) -> object:
    if isinstance(value, str):
        for source, target in sorted(replacements.items(), key=lambda item: len(item[0]), reverse=True):
            value = value.replace(source, target)
        return value
    if isinstance(value, list):
        return [replace_paths(item, replacements) for item in value]
    if isinstance(value, dict):
        return {key: replace_paths(item, replacements) for key, item in value.items()}
    return value


def redact(text: str, prompt: bytes, replacements: dict[str, str]) -> tuple[str, int]:
    values = [prompt.decode("utf-8")]
    for key, value in os.environ.items():
        upper = key.upper()
        if len(value) >= 8 and any(marker in upper for marker in ("KEY", "TOKEN", "SECRET", "PASSWORD")):
            values.append(value)
    redacted = text
    count = 0
    redacted = str(replace_paths(redacted, replacements))
    variants = set()
    for value in values:
        variants.add(value)
        variants.add(json.dumps(value, ensure_ascii=False)[1:-1])
        variants.add(json.dumps(value, ensure_ascii=True)[1:-1])
    for value in sorted(variants, key=len, reverse=True):
        if value and value in redacted:
            occurrences = redacted.count(value)
            redacted = redacted.replace(value, "[REDACTED]")
            count += occurrences
    for pattern in SECRET_PATTERNS:
        redacted, replacements_made = pattern.subn("[REDACTED_SECRET_PATTERN]", redacted)
        count += replacements_made
    return redacted, count


def redact_value(value: object, prompt: bytes, replacements: dict[str, str]) -> tuple[object, int]:
    if isinstance(value, str):
        return redact(value, prompt, replacements)
    if isinstance(value, list):
        redacted_items = []
        count = 0
        for item in value:
            redacted_item, item_count = redact_value(item, prompt, replacements)
            redacted_items.append(redacted_item)
            count += item_count
        return redacted_items, count
    if isinstance(value, dict):
        redacted_items = {}
        count = 0
        for key, item in value.items():
            redacted_item, item_count = redact_value(item, prompt, replacements)
            redacted_items[key] = redacted_item
            count += item_count
        return redacted_items, count
    return value, 0


def parse_output(stdout: str) -> tuple[dict | None, dict | None, dict | None]:
    text = stdout.strip()
    if not text:
        return None, None, None
    try:
        direct = json.loads(text)
        if isinstance(direct, dict) and set(direct) == REVIEW_KEYS:
            return direct, None, None
        if isinstance(direct, dict) and isinstance(direct.get("structured_output"), dict):
            return direct["structured_output"], direct, None
    except json.JSONDecodeError:
        pass
    events = []
    for line in text.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            return None, None, None
        if not isinstance(event, dict):
            return None, None, None
        events.append(event)
    init = next((event for event in events if event.get("type") == "system" and event.get("subtype") == "init"), None)
    result = next((event for event in reversed(events) if event.get("type") == "result"), None)
    review = result.get("structured_output") if isinstance(result, dict) else None
    return review if isinstance(review, dict) else None, result, init


def count_tool_calls(stdout: str) -> int:
    def count(value: object) -> int:
        if isinstance(value, list):
            return sum(count(item) for item in value)
        if not isinstance(value, dict):
            return 0
        own = 1 if value.get("type") in (
            "tool_use",
            "tool_call",
            "tool_result",
            "server_tool_use",
            "web_search_tool_result",
        ) else 0
        return own + sum(count(item) for item in value.values())

    text = stdout.strip()
    if not text:
        return 0
    try:
        return count(json.loads(text))
    except json.JSONDecodeError:
        total = 0
        for line in text.splitlines():
            try:
                total += count(json.loads(line))
            except json.JSONDecodeError:
                continue
        return total


def validate_review(review: object) -> str | None:
    if not isinstance(review, dict):
        return "structured review is missing"
    if set(review) != REVIEW_KEYS:
        return "structured review keys do not match the closed schema"
    if review.get("verdict") not in VERDICTS:
        return "structured review verdict is invalid"
    for key in REVIEW_KEYS - {"verdict"}:
        value = review.get(key)
        if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
            return f"structured review field {key} must be an array of strings"
    return None


def classify_result(returncode: int | None, timed_out: bool, review: dict | None, result: dict | None) -> tuple[str, str | None]:
    if timed_out:
        return "timeout", "wall-clock timeout terminated the Grok process tree"
    subtype = result.get("subtype") if isinstance(result, dict) else None
    stop = (result.get("stop_reason") or result.get("stopReason")) if isinstance(result, dict) else None
    if subtype == "error_max_turns" or stop in ("max_turns", "max_turns_reached"):
        return "max-turns", "Grok reached the max-turn limit"
    if returncode != 0:
        return "nonzero-exit", f"Grok exited with status {returncode}"
    if isinstance(result, dict) and result.get("type") == "result" and result.get("is_error") is True:
        return "incomplete-stop-reason", "Grok returned an error result"
    problem = validate_review(review)
    if problem:
        return "invalid-json", problem
    if result is None:
        return "ok", None
    if subtype not in (None, "success") or stop != "end_turn":
        return "incomplete-stop-reason", f"Grok stopped incompletely: subtype={subtype!r}, stop={stop!r}"
    return "ok", None


def web_search_requests(result: dict | None) -> object:
    if not isinstance(result, dict):
        return None
    usage = result.get("usage")
    if not isinstance(usage, dict):
        return None
    server_usage = usage.get("server_tool_use")
    if not isinstance(server_usage, dict):
        return None
    return server_usage.get("web_search_requests")


def runtime_reasons(init: dict | None, result: dict | None) -> list[str]:
    if init is None:
        return ["streaming runtime init event is missing"]
    reasons = []
    if init.get("skills") != []:
        reasons.append("runtime skills are not exactly empty")
    if init.get("mcp_servers") != []:
        reasons.append("runtime MCP servers are not exactly empty")
    tools = init.get("tools")
    if tools != ["todo_write", "search_tool", "use_tool"]:
        reasons.append(f"runtime tool surface changed: {tools!r}")
    if web_search_requests(result) != 0:
        reasons.append("runtime did not prove zero web search requests")
    return reasons


def main() -> int:
    try:
        args = parse_args()
    except ConsultationError as exc:
        return emit({"status": exc.category, "message": str(exc)}, EXIT[exc.category])
    run_id = str(uuid.uuid4())
    try:
        run_dir = args.output_dir.expanduser().resolve() / f"run-{run_id}"
        run_dir.mkdir(parents=True, exist_ok=False, mode=0o700)
        if os.name == "posix":
            run_dir.chmod(0o700)
    except (OSError, RuntimeError) as exc:
        return emit(
            {"status": "input", "message": f"Cannot create output directory: {exc}"},
            EXIT["input"],
        )
    metadata: dict = {"runId": run_id, "mode": args.mode, "status": "starting"}
    try:
        if not math.isfinite(args.timeout) or not 0 < args.timeout <= 600:
            raise ConsultationError("input", "timeout must be finite and between 0 and 600 seconds")
        if not 0 < args.max_turns <= 8:
            raise ConsultationError("input", "max-turns must be between 1 and 8")
        prompt = read_prompt(args.prompt_file.expanduser().resolve())
        binary = resolve_binary(args.grok_bin)
        grok_home, grok_home_explicit = resolve_grok_home(args)
        selected_auth = auth_source(grok_home)
        if args.mode == "automatic" and selected_auth is None:
            raise ConsultationError(
                "isolation-failure",
                "Automatic mode requires existing auth in the dedicated profile or XAI_API_KEY",
            )
        metadata["prompt"] = {"bytes": len(prompt), "sha256": sha256_bytes(prompt)}
        default_grok_home = (Path.home() / ".grok").resolve()
        metadata["grokHome"] = {
            "kind": "default" if grok_home == default_grok_home else "dedicated",
            "explicit": grok_home_explicit,
        }
        metadata["authentication"] = {"source": selected_auth or "not-detected"}

        with tempfile.TemporaryDirectory(prefix="toolboxmd-use-grok-") as temp_name:
            stage = Path(temp_name)
            staged_home = stage / "home"
            work = stage / "review"
            staged_home.mkdir()
            work.mkdir()
            prompt_path = work / "brief.md"
            agent_path = work / "reviewer-agent.md"
            prompt_path.write_bytes(prompt)
            write_text(agent_path, AGENT_DEFINITION)
            env = controlled_env(staged_home, grok_home)
            leader = stage / "leader.sock"
            version, inspected = preflight(binary, args, work, env, leader)
            path_replacements = {
                str(stage.resolve()): "<staging-dir>",
                str(stage): "<staging-dir>",
                str(grok_home): "<grok-home>",
            }
            write_json(run_dir / "inspect-summary.json", inspect_summary(inspected))
            metadata["grokVersion"] = version
            metadata["preflight"] = {
                "passed": True,
                "compatibilityFlags": sorted(COMPAT_FLAGS),
                "customAgentSha256": sha256_bytes(AGENT_DEFINITION.encode()),
                "stagedCwd": True,
                "stagedHome": True,
            }
            if args.mode == "automatic" and not AUTOMATIC_MODE_ACCEPTED:
                raise ConsultationError(
                    "isolation-failure",
                    "Automatic mode is disabled pending dedicated-profile real acceptance",
                )
            schema = json.dumps(REVIEW_SCHEMA, separators=(",", ":"), sort_keys=True)
            argv = [
                binary,
                "--agent",
                str(agent_path),
                "--prompt-file",
                str(prompt_path),
                "--verbatim",
                "--cwd",
                str(work),
                "--session-id",
                run_id,
                "--leader-socket",
                str(leader),
                "--sandbox",
                "read-only",
                "--no-memory",
                "--no-subagents",
                "--disable-web-search",
                "--no-plan",
                "--max-turns",
                str(args.max_turns),
                "--tools",
                "todo_write",
                "--disallowed-tools",
                "Agent",
                "--permission-mode",
                "dontAsk",
                "--deny",
                "Read",
                "--deny",
                "MCPTool",
                "--output-format",
                "streaming-messages-json",
                "--json-schema",
                schema,
            ]
            if args.model:
                argv.extend(("--model", args.model))
            returncode, stdout, stderr, timed_out, duration = run_grok(argv, work, env, args.timeout)
            clean_stdout, stdout_redactions = redact(stdout, prompt, path_replacements)
            clean_stderr, stderr_redactions = redact(stderr, prompt, path_replacements)
            write_text(run_dir / "stdout.raw.txt", clean_stdout)
            write_text(run_dir / "stderr.raw.txt", clean_stderr)
            review, result, init = parse_output(stdout)
            tool_call_count = count_tool_calls(stdout)
            observed_web_requests = web_search_requests(result)
            category, message = classify_result(returncode, timed_out, review, result)
            if category == "ok" and tool_call_count:
                category, message = "isolation-failure", "Grok emitted a tool call despite the no-tools contract"
            if category == "ok" and isinstance(observed_web_requests, int) and observed_web_requests > 0:
                category, message = "isolation-failure", "Grok used web search despite the no-web contract"
            if category == "ok":
                reasons = (
                    runtime_reasons(init, result)
                    if init is not None
                    else inspect_reasons(inspected, True)
                )
                if reasons:
                    category, message = "isolation-failure", "; ".join(reasons)
            metadata.update(
                {
                    "status": category,
                    "message": message,
                    "process": {
                        "returncode": returncode,
                        "timedOut": timed_out,
                        "durationMs": round(duration * 1000),
                        "maxTurns": args.max_turns,
                        "timeoutSeconds": args.timeout,
                    },
                    "invocation": {
                        "argv": replace_paths(argv, path_replacements),
                        "environmentKeys": sorted(env),
                        "shell": False,
                    },
                    "runtime": {
                        "sessionId": result.get("session_id") if isinstance(result, dict) else run_id,
                        "stopReason": result.get("stop_reason") if isinstance(result, dict) else None,
                        "usage": result.get("usage") if isinstance(result, dict) else None,
                        "initObserved": init is not None,
                        "tools": init.get("tools") if isinstance(init, dict) else None,
                        "skills": init.get("skills") if isinstance(init, dict) else None,
                        "mcpServers": init.get("mcp_servers") if isinstance(init, dict) else None,
                        "toolCallsObserved": tool_call_count,
                        "webSearchRequests": observed_web_requests,
                        "isolationEvidence": "streaming-init" if init is not None else "strict-inspect-fallback",
                    },
                    "redactionsApplied": stdout_redactions + stderr_redactions,
                }
            )
            if category == "ok" and review is not None:
                redacted_review, review_redactions = redact_value(review, prompt, path_replacements)
                metadata["redactionsApplied"] += review_redactions
                redaction_problem = validate_review(redacted_review)
                if redaction_problem:
                    category = "invalid-json"
                    message = f"Review redaction invalidated the structured schema: {redaction_problem}"
                    metadata["status"] = category
                    metadata["message"] = message
                else:
                    write_json(run_dir / "review.json", redacted_review)
            write_json(run_dir / "metadata.json", metadata)
            payload = {"status": category, "message": message, "runDir": str(run_dir)}
            return emit(payload, EXIT[category])
    except ConsultationError as exc:
        metadata.update({"status": exc.category, "message": str(exc)})
        write_json(run_dir / "metadata.json", metadata)
        return emit({"status": exc.category, "message": str(exc), "runDir": str(run_dir)}, EXIT[exc.category])
    except Exception as exc:
        metadata.update({"status": "input", "message": f"Unexpected adapter error: {exc}"})
        write_json(run_dir / "metadata.json", metadata)
        return emit({"status": "input", "message": metadata["message"], "runDir": str(run_dir)}, EXIT["input"])


if __name__ == "__main__":
    sys.exit(main())
