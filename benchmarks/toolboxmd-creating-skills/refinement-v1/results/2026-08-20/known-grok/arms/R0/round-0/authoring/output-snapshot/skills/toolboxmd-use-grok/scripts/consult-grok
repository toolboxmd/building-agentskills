#!/usr/bin/env python3
"""Fail-closed adapter for a bounded Grok Build consultation."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import tempfile
import uuid

VERDICTS = {"PROCEED", "PROCEED WITH CHANGES", "REPLAN", "NEEDS HUMAN DECISION"}
SECTIONS = ("overengineering", "missing", "risks", "minimum_plan_delta", "user_decisions")
SCHEMA = {
    "type": "object",
    "properties": {
        "verdict": {"type": "string", "enum": sorted(VERDICTS)},
        **{name: {"type": "array", "items": {"type": "string"}} for name in SECTIONS},
    },
    "required": ["verdict", *SECTIONS],
    "additionalProperties": False,
}
SAFE_INSPECT_KEYS = {
    "grokVersion", "cwd", "projectRoot", "projectInstructions", "skills", "agents",
    "mcpServers", "plugins", "hooks", "marketplaces", "externalCompat",
    "configSources", "configWarnings", "permissions",
}
REDACTIONS = (
    re.compile(r"(?i)(XAI_API_KEY\s*[=:]\s*)[^\s\"']+"),
    re.compile(r"(?i)(authorization\s*[=:]\s*bearer\s+)[^\s\"']+"),
    re.compile(r"\bxai-[A-Za-z0-9_-]{8,}\b"),
)


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument("--mode", required=True, choices=("explicit", "automatic"))
    parser.add_argument("--prompt-file", required=True)
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--grok-home", required=True)
    parser.add_argument("--grok-bin", required=True)
    parser.add_argument("--timeout", required=True, type=float)
    parser.add_argument("--max-turns", required=True, type=int)
    return parser.parse_args()


def emit(status: str, **fields: object) -> int:
    print(json.dumps({"status": status, **fields}, ensure_ascii=False, sort_keys=True))
    return 0 if status == "ok" else 1


def redact(value: str) -> str:
    for pattern in REDACTIONS:
        value = pattern.sub(lambda match: (match.group(1) if match.lastindex else "") + "[REDACTED]", value)
    return value


def isolated_environment(grok_home: Path) -> dict[str, str]:
    env = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "GROK_HOME": str(grok_home),
        "HOME": str(grok_home),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "NO_COLOR": "1",
        "GROK_DISABLE_CURSOR": "1",
        "GROK_DISABLE_CLAUDE": "1",
    }
    if os.environ.get("XAI_API_KEY"):
        env["XAI_API_KEY"] = os.environ["XAI_API_KEY"]
    return env


def run_bounded(argv: list[str], cwd: Path, env: dict[str, str], timeout: float) -> tuple[int, str, str]:
    process = subprocess.Popen(
        argv, cwd=cwd, env=env, text=True, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, start_new_session=True,
    )
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            stdout, stderr = process.communicate(timeout=1)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            stdout, stderr = process.communicate()
        raise ConsultationTimeout(stdout, stderr)
    return process.returncode, stdout, stderr


class ConsultationTimeout(Exception):
    def __init__(self, stdout: str, stderr: str) -> None:
        self.stdout = stdout
        self.stderr = stderr


def inspect_isolated(binary: Path, cwd: Path, env: dict[str, str], timeout: float) -> tuple[bool, object]:
    try:
        result = subprocess.run(
            [str(binary), "inspect", "--json"], cwd=cwd, env=env, text=True,
            capture_output=True, timeout=min(timeout, 15), start_new_session=True,
        )
        value = json.loads(result.stdout)
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError) as error:
        return False, {"error": type(error).__name__}
    if result.returncode or not isinstance(value, dict) or set(value) != SAFE_INSPECT_KEYS:
        return False, value
    compat = value.get("externalCompat")
    cells = compat.get("cells") if isinstance(compat, dict) else None
    valid_cells = isinstance(cells, list) and cells and all(
        isinstance(cell, dict) and cell.get("enabled") is False for cell in cells
    )
    agents = value.get("agents")
    builtin_agents = isinstance(agents, list) and all(
        isinstance(agent, dict) and agent.get("source", {}).get("type") == "builtin" for agent in agents
    )
    clean = (
        value.get("projectRoot") is None and value.get("projectInstructions") == []
        and value.get("skills") == [] and value.get("mcpServers") == []
        and value.get("plugins") == [] and value.get("hooks") == []
        and value.get("marketplaces") == [] and valid_cells and builtin_agents
        and compat.get("remoteSettingsLoaded") is False
        and value.get("configSources", {}).get("layers") == []
        and value.get("configWarnings") is None
        and value.get("permissions", {}).get("managedSettingsActive") is False
    )
    return bool(clean), value


def validate_review(value: object) -> dict[str, object] | None:
    if not isinstance(value, dict) or set(value) != {"verdict", *SECTIONS}:
        return None
    if value.get("verdict") not in VERDICTS:
        return None
    if any(not isinstance(value[name], list) or any(not isinstance(item, str) for item in value[name]) for name in SECTIONS):
        return None
    return value


def parse_output(stdout: str) -> tuple[dict[str, object] | None, dict[str, object]]:
    records: list[object] = []
    try:
        direct = json.loads(stdout)
        records = [direct]
    except json.JSONDecodeError:
        try:
            records = [json.loads(line) for line in stdout.splitlines() if line.strip()]
        except json.JSONDecodeError:
            return None, {}
    metadata: dict[str, object] = {}
    candidate: object = records[0] if len(records) == 1 else None
    for record in records:
        if not isinstance(record, dict):
            continue
        if record.get("type") == "assistant":
            content = record.get("message", {}).get("content", [])
            if any(isinstance(item, dict) and item.get("type") == "tool_use" for item in content):
                metadata["tool_call"] = True
        if record.get("type") == "system" and record.get("subtype") == "init":
            metadata["session_id"] = record.get("session_id")
        if record.get("type") == "result" or "structured_output" in record:
            candidate = record.get("structured_output")
            metadata.update({key: record.get(key) for key in ("session_id", "usage", "stop_reason", "stopReason", "subtype", "is_error") if key in record})
    if isinstance(candidate, dict) and set(candidate) == {"structured_output", "stopReason"}:
        metadata["stopReason"] = candidate.get("stopReason")
        candidate = candidate.get("structured_output")
    return validate_review(candidate), metadata


def main() -> int:
    args = arguments()
    if args.mode == "automatic":
        return emit("isolation-failure", mode="automatic", detail="automatic mode disabled pending real acceptance")
    if args.timeout <= 0 or args.max_turns <= 0:
        return emit("isolation-failure", detail="timeout and max-turns must be positive")
    binary = Path(args.grok_bin).expanduser().resolve()
    if not binary.is_file() or not os.access(binary, os.X_OK):
        return emit("missing-cli", detail="grok executable is missing or not executable")
    prompt = Path(args.prompt_file).expanduser().resolve()
    home = Path(args.grok_home).expanduser().resolve()
    output = Path(args.output_dir).expanduser().resolve()
    if not prompt.is_file() or not home.is_dir():
        return emit("isolation-failure", detail="prompt file or GROK_HOME is unavailable")
    try:
        prompt_text = prompt.read_text(encoding="utf-8")
        output.mkdir(parents=True, exist_ok=True)
    except (OSError, UnicodeError) as error:
        return emit("isolation-failure", detail=type(error).__name__)
    run_id = str(uuid.uuid4())
    env = isolated_environment(home)
    evidence_file = output / f"grok-consultation-{run_id}.json"
    with tempfile.TemporaryDirectory(prefix=f"grok-{run_id}-", dir=output) as temporary:
        stage = Path(temporary)
        staged_prompt = stage / "prompt.txt"
        staged_agent = stage / "agent.md"
        staged_prompt.write_text(prompt_text, encoding="utf-8")
        staged_agent.write_text(
            "Review only the supplied prompt. Do not use tools, MCP, web, agents, agentic CLIs, memory, or external files. Return only the required structured review.\n",
            encoding="utf-8",
        )
        isolated, inspected = inspect_isolated(binary, stage, env, args.timeout)
        if not isolated:
            return emit("isolation-failure", detail="effective configuration is outside the frozen allow-list")
        argv = [
            str(binary), "--prompt-file", str(staged_prompt), "--agent", str(staged_agent),
            "--output-format", "stream-json", "--json-schema", json.dumps(SCHEMA, separators=(",", ":")),
            "--sandbox", "read-only", "--no-memory", "--no-subagents", "--no-web",
            "--deny-mcp", "--max-turns", str(args.max_turns),
        ]
        try:
            returncode, stdout, stderr = run_bounded(argv, stage, env, args.timeout)
        except ConsultationTimeout as error:
            evidence_file.write_text(json.dumps({"run_id": run_id, "argv": [Path(argv[0]).name, *argv[1:]], "stdout": redact(error.stdout), "stderr": redact(error.stderr), "status": "timeout"}, ensure_ascii=False, indent=2), encoding="utf-8")
            return emit("timeout", evidence_file=str(evidence_file))
        review, metadata = parse_output(stdout)
        evidence = {
            "run_id": run_id, "mode": args.mode, "argv": [Path(argv[0]).name, *argv[1:]],
            "cwd": "isolated-staging-directory", "environment_keys": sorted(env),
            "inspect": inspected, "returncode": returncode, "stdout": redact(stdout),
            "stderr": redact(stderr), "session_id": metadata.get("session_id"),
            "usage": metadata.get("usage"), "stop_reason": metadata.get("stop_reason", metadata.get("stopReason")),
        }
        status = "ok"
        if metadata.get("tool_call"):
            status = "isolation-failure"
        elif metadata.get("subtype") == "error_max_turns" or (returncode and "max_turn" in stdout.lower()):
            status = "max-turns"
        elif returncode:
            status = "nonzero-exit"
        elif review is None:
            status = "invalid-json"
        elif metadata.get("is_error") is True or metadata.get("stop_reason", metadata.get("stopReason", "end_turn")) != "end_turn":
            status = "incomplete-stop-reason"
        evidence["status"] = status
        evidence_file.write_text(json.dumps(evidence, ensure_ascii=False, indent=2, sort_keys=True), encoding="utf-8")
        if status != "ok":
            return emit(status, evidence_file=str(evidence_file))
        return emit("ok", review=review, evidence_file=str(evidence_file))


if __name__ == "__main__":
    raise SystemExit(main())
